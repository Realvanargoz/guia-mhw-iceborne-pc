# La app ya no usa Docker ni Postgres. Todo es opcional: sin tocar nada arranca en 127.0.0.1:8765
# y detecta sola tu partida de Steam (solo lectura). Copia este archivo a .env solo si necesitas cambiar algo.

# MHW_HOST=127.0.0.1            # interfaz de escucha. No lo cambies: la app no debe abrirse a la red
# MHW_PORT=8765
# MHW_ALLOWED_HOSTS=            # hosts extra permitidos (separados por comas)
# MHW_DOCS_ENABLED=true         # /docs, /redoc, /openapi.json (false por defecto en el ejecutable)
# MHW_USER_DATA_DIR=            # tus datos (user.db, copia de la partida, copias de seguridad). Por defecto ./data
# MHW_CATALOG_DB=               # catálogo SQLite (por defecto build/catalog.db)
# MHW_RESEARCH_DIR=             # carpeta research/ (por defecto ./research)
# MHW_WEB_DIST=                 # web/dist compilado: la API lo sirve junto con el SPA
# MHW_ICONS_DIR=                # carpeta de iconos del juego (por defecto data/icons con scripts/dev.ps1)

# Ruta de la partida: normalmente no hace falta. Si Steam está en otro sitio, elígela en la página de inicio
# («Usar esta ruta») o aquí. Siempre de solo lectura; la sincronización es manual (botón «Actualizar perfil»).
# MHW_SAVE_MOUNT= / MHW_STATS_MOUNT=
