{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research seed: festivals",
  "type": "object",
  "required": ["topic", "entries"],
  "properties": {
    "topic": {"const": "festivals"},
    "notebook": {"type": "string"},
    "retrieved_at": {"type": "string"},
    "notes": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "season", "name_es", "astera_en", "seliana_en", "theme", "sources"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "season": {"enum": ["spring", "summer", "autumn", "winter", "appreciation"]},
          "name_es": {"type": "string"},
          "astera_en": {"type": "string"},
          "seliana_en": {"type": "string"},
          "theme": {"enum": ["spring", "summer", "autumn", "winter", "appreciation"]},
          "sort_order": {"type": "integer"},
          "summary_es": {"type": "string"},
          "tickets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item_en"],
              "properties": {"item_en": {"type": "string"}, "note_es": {"type": "string"}},
              "additionalProperties": false
            }
          },
          "layered": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["slug"],
              "properties": {"slug": {"type": "string"}, "name_es": {"type": "string"}},
              "additionalProperties": false
            }
          },
          "known_periods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end", "source"],
              "properties": {
                "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "source": {"type": "string", "pattern": "^https?://"}
              },
              "additionalProperties": false
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {"title": {"type": "string"}, "url": {"type": "string", "pattern": "^https?://"}, "note": {"type": "string"}}
            }
          },
          "needs_review": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  }
}
