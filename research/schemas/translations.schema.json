{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research seed: translations",
  "type": "object",
  "required": [
    "topic",
    "entries"
  ],
  "properties": {
    "topic": {
      "const": "translations"
    },
    "notebook": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "name_en",
          "name_es",
          "sources"
        ],
        "properties": {
          "type": {
            "enum": [
              "item",
              "monster",
              "location",
              "armor",
              "armor_set",
              "weapon",
              "skill",
              "decoration",
              "charm",
              "quest",
              "set_bonus"
            ]
          },
          "name_en": {
            "type": "string"
          },
          "name_es": {
            "type": "string"
          },
          "override": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
