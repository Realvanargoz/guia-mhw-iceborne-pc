{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "topic",
    "entries"
  ],
  "title": "research seed: canteen",
  "properties": {
    "topic": {
      "const": "canteen"
    },
    "notebook": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "game": {
      "type": "string"
    },
    "entries": {
      "type": "object",
      "required": [
        "ingredients",
        "skills",
        "rules"
      ],
      "properties": {
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name_en",
              "category",
              "skill_type",
              "unlock",
              "sources"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "name_en": {
                "type": "string"
              },
              "name_es": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "category": {
                "enum": [
                  "meat",
                  "fish",
                  "veggie",
                  "drink"
                ]
              },
              "category_es": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "skill_type": {
                "type": "string"
              },
              "skill_type_es": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description_en": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description_es": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "unlock": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "base",
                      "quest",
                      "delivery",
                      "bounty",
                      "gathering"
                    ]
                  },
                  "detail_en": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "is_base": {
                    "type": "boolean"
                  },
                  "quest_en": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "event_dependent": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "fextralife_item": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "fextralife_raw": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "can_be_fresh": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              },
              "review_notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "needs_review": {
                "type": "boolean"
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name_en",
              "kind",
              "sources"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "name_en": {
                "type": "string"
              },
              "name_es": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effect_en": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effect_es": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "enum": [
                  "ingredient",
                  "daily",
                  "unavailable"
                ]
              },
              "skill_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "skill_type_es": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tier": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 3
              },
              "ingredients_required": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "activation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hunter_effect": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "palico_effect": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "duration": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pool_note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note_es": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kiranico_activation_raw": {},
              "numeric_details": {},
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              },
              "review_notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "needs_review": {
                "type": "boolean"
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "topic",
              "title_es",
              "text_es",
              "sources"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "topic": {
                "type": "string"
              },
              "title_es": {
                "type": "string"
              },
              "text_es": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              },
              "review_notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "needs_review": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
