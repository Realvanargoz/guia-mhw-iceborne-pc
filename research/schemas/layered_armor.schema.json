{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research seed: layered_armor",
  "type": "object",
  "required": [
    "topic",
    "entries"
  ],
  "properties": {
    "topic": {
      "const": "layered_armor"
    },
    "notebook": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "name_en",
          "category",
          "unlock_es",
          "pc_available",
          "sources"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name_en": {
            "type": "string"
          },
          "name_es": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "enum": [
              "monster_mr",
              "event",
              "festival",
              "collab",
              "guild_palace",
              "comic",
              "other"
            ]
          },
          "owner": {
            "enum": [
              "hunter",
              "palico",
              "handler"
            ]
          },
          "pieces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name_en"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "head",
                    "chest",
                    "arms",
                    "waist",
                    "legs",
                    "full",
                    "weapon",
                    "other"
                  ]
                },
                "name_en": {
                  "type": "string"
                },
                "name_es": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "unlock_en": {
            "type": [
              "string",
              "null"
            ]
          },
          "unlock_es": {
            "type": "string"
          },
          "steps_es": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item_en",
                "qty"
              ],
              "properties": {
                "item_en": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer"
                },
                "per_piece": {
                  "type": "boolean"
                },
                "piece": {
                  "type": "string"
                }
              }
            }
          },
          "quests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name_en"
              ],
              "properties": {
                "name_en": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "event",
                    "challenge",
                    "optional",
                    "special",
                    "story",
                    "siege",
                    "arena"
                  ]
                },
                "note_es": {
                  "type": "string"
                }
              }
            }
          },
          "pc_available": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "pc_notes_es": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "needs_review": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
