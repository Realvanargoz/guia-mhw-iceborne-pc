     class Utils
     {
+        // [mhw-guide patch] Configurable Oodle DLL.
+        // The P/Invoke keeps the upstream name; a DllImportResolver maps it to the file named by the
+        // OODLE_DLL env var (bare file name -> looked up next to the exe; or an absolute path).
+        public const string OodleImportName = "oo2core_8_win64.dll";
+
+        public static string OodleDllPath()
+        {
+            string name = Environment.GetEnvironmentVariable("OODLE_DLL");
+            if (string.IsNullOrWhiteSpace(name)) name = OodleImportName;
+            return Path.IsPathRooted(name) ? name : Path.Combine(AppContext.BaseDirectory, name);
+        }
+
+        public static void RegisterOodleResolver()
+        {
+            NativeLibrary.SetDllImportResolver(typeof(Utils).Assembly, (libraryName, assembly, searchPath) =>
+            {
+                if (libraryName == OodleImportName) return NativeLibrary.Load(OodleDllPath());
+                return IntPtr.Zero;
+            });
+        }
+
         // Import Oodle decompression
