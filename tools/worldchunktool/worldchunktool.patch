diff -ruN orig/WorldChunkTool/Properties/KeySeqResource.cs mod/WorldChunkTool/Properties/KeySeqResource.cs
--- orig/WorldChunkTool/Properties/KeySeqResource.cs	1969-12-31 19:00:00.000000000 -0500
+++ mod/WorldChunkTool/Properties/KeySeqResource.cs	2026-11-15 00:13:02.267334100 -0500
@@ -0,0 +1,30 @@
+// [mhw-guide patch] Replacement for the ResX-generated Resources.Designer.cs.
+// Exposes the original Resources/keyseq.key (embedded unchanged) under the same
+// name the upstream code uses: Properties.Resources.keyseq
+using System.IO;
+using System.Reflection;
+
+namespace WorldChunkTool.Properties
+{
+    internal static class Resources
+    {
+        private static byte[] _keyseq;
+
+        internal static byte[] keyseq
+        {
+            get
+            {
+                if (_keyseq == null)
+                {
+                    using (Stream s = Assembly.GetExecutingAssembly().GetManifestResourceStream("WorldChunkTool.Resources.keyseq.key"))
+                    using (MemoryStream ms = new MemoryStream())
+                    {
+                        s.CopyTo(ms);
+                        _keyseq = ms.ToArray();
+                    }
+                }
+                return _keyseq;
+            }
+        }
+    }
+}
