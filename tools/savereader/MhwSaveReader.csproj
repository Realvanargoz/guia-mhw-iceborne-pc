<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>mhw-savereader</AssemblyName>
    <RootNamespace>MhwSaveReader</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Vendored third-party code predates nullable annotations and uses AesManaged. -->
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8632;SYSLIB0021;CA1815</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/jewels.json" LogicalName="jewels.json" />
    <EmbeddedResource Include="Data/equipment.json" LogicalName="equipment.json" />
    <EmbeddedResource Include="Data/quest_order.json" LogicalName="quest_order.json" />
    <EmbeddedResource Include="Data/monsters128.json" LogicalName="monsters128.json" />
  </ItemGroup>

</Project>
